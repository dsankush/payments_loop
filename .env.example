# Copy these names into Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values to GitHub.

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase SECRET / service_role key (Supabase -> Project Settings -> API Keys). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random text (at least 32 characters). Signs login sessions.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# The password you choose for the admin page.
ADMIN_CODE=
